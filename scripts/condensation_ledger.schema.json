{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "condensation/v1",
  "title": "Current executable survivor ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cluster",
    "bead",
    "contract",
    "removed",
    "survivors",
    "binding",
    "proof",
    "seconds"
  ],
  "properties": {
    "schema": {
      "const": "condensation/v1"
    },
    "cluster": {
      "type": "string",
      "minLength": 1
    },
    "bead": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "cites"
      ],
      "properties": {
        "class": {
          "enum": [
            "architecture",
            "wire",
            "privacy",
            "authorization",
            "retry",
            "idempotency",
            "migration",
            "capability"
          ]
        },
        "cites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "removed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node",
          "params",
          "survivors",
          "reason"
        ],
        "properties": {
          "node": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "integer",
            "minimum": 1
          },
          "survivors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "survivors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node",
          "params"
        ],
        "properties": {
          "node": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "head",
        "tree",
        "inputs",
        "inputs_hash",
        "nonce",
        "selection",
        "scope",
        "tools"
      ],
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "mode"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "mode": {
                "enum": [
                  "100644",
                  "100755",
                  "120000"
                ]
              },
              "link": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "120000"
                    }
                  }
                },
                "then": {
                  "required": [
                    "link"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "link"
                    ]
                  }
                }
              }
            ]
          }
        },
        "inputs_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selection": {
          "type": "object",
          "required": [
            "removed",
            "survivors"
          ],
          "additionalProperties": false,
          "properties": {
            "removed": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "survivors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "python",
            "pytest",
            "coverage",
            "closure"
          ],
          "properties": {
            "python": {
              "type": "string",
              "minLength": 1
            },
            "pytest": {
              "type": "string",
              "minLength": 1
            },
            "coverage": {
              "type": "string",
              "minLength": 1
            },
            "closure": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status",
        "restored",
        "cleanup",
        "coverage",
        "mutation",
        "runs"
      ],
      "properties": {
        "mode": {
          "const": "cov+mut"
        },
        "status": {
          "const": "PASS"
        },
        "restored": {
          "const": true
        },
        "cleanup": {
          "const": true
        },
        "coverage": {
          "type": "object",
          "required": [
            "core",
            "branch",
            "residue_arcs",
            "residue",
            "waived"
          ],
          "additionalProperties": false,
          "properties": {
            "core": {
              "const": "ctrace"
            },
            "branch": {
              "const": true
            },
            "residue_arcs": {
              "const": 0
            },
            "residue": {
              "type": "array",
              "maxItems": 0
            },
            "waived": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        "mutation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seed",
            "generated",
            "mutants",
            "killed_by_removed",
            "killed_by_survivors",
            "lost",
            "unknown"
          ],
          "properties": {
            "seed": {
              "const": 0
            },
            "generated": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "mutants": {
              "type": "array",
              "minItems": 1
            },
            "killed_by_removed": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "killed_by_survivors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "lost": {
              "type": "array",
              "maxItems": 0
            },
            "unknown": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        "runs": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": [
              "id",
              "side",
              "selected",
              "deselected",
              "complete",
              "cleanup",
              "cases",
              "arcs",
              "scope",
              "scope_inputs",
              "tools",
              "core",
              "tracer",
              "exit",
              "selection",
              "command_flags",
              "measurement_root",
              "artifact",
              "coverage_artifact"
            ]
          }
        }
      }
    },
    "seconds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "after": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  },
  "$comment": "Schema documents serialization only. The single stdlib consumer additionally admits exact current Git bodies/modes, complete actual SQLite/run carriers, case multiplicities, named mutant kills, restoration and no residue; schema validity alone grants no deletion authority."
}
