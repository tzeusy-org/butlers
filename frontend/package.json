{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "npm run typecheck:e2e && tsc -b && vite build --configLoader runner",
    "lint": "eslint . && npm run lint:draft-eligibility",
    "lint:draft-eligibility": "node scripts/check-draft-eligibility.mjs",
    "lint:emdash": "node scripts/check-em-dash-copy.mjs",
    "lint:query-coercion": "node scripts/check-query-result-coercion.mjs",
    "knip": "knip",
    "preview": "vite preview --configLoader runner",
    "test": "vitest run --configLoader runner",
    "story:test": "vitest run --configLoader runner --reporter=verbose src/**/*.a11y.test.tsx",
    "test:e2e": "npm run typecheck:e2e && playwright test",
    "test:e2e:headed": "npm run typecheck:e2e && playwright test --headed",
    "test:e2e:install": "node scripts/install-playwright-browsers.mjs",
    "test:owner-auth": "playwright test --config playwright.owner-auth.config.ts",
    "test:e2e:cache-version": "node scripts/playwright-cache-version.mjs",
    "typecheck:e2e": "node --test --test-timeout=300000 scripts/check-e2e-api-mocks.node.mjs && node scripts/check-e2e-api-mocks.mjs && tsc -p tsconfig.e2e.json --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@tanstack/react-query": "^5.90.20",
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "h3-js": "^4.4.0",
    "lucide-react": "^0.563.0",
    "maplibre-gl": "^5.24.0",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router": "^7.13.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^28.0.0",
    "knip": "^6.26.0",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "minimatch@^10.0.0": "^10.2.2",
    "eslint-plugin-jsx-a11y": {
      "minimatch": "^3.1.2"
    }
  }
}
