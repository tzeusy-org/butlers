{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/e2e-api-mock.mjs",
    "playwright.route-a.config.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "binaries": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "duplicates": "error",
    "enumMembers": "off"
  },
  "ignoreBinaries": [
    "openssl"
  ]
}
