# syntax=docker/dockerfile:1.7

# Butlers base image — system deps, LLM runtime CLIs, uv.
#
# This image changes infrequently (only when system deps or npm packages
# change). Build it once and reference from Dockerfile:
#
#   docker build --build-context system-artifacts=/path/to/closed/context \
#     -f Dockerfile.base -t butlers-base .
#
# The application Dockerfile consumes the coordinated output by immutable
# reference and installs its independently verified Python profile offline.

# Exact official Linux/amd64 Python child. Update its verified digest and
# the matching Debian baseline/archive manifest together.
FROM python:3.12.13-slim-trixie@sha256:c2d8472b831337ab296a8ce652e1ba786e9e3034fc445dc58b50a7f5251f0003 AS system-inputs
COPY scripts/runtime_clis/install_system_artifacts.py /tmp/install_system_artifacts.py
COPY deploy/runtime-clis/debian-system-inputs.json /tmp/debian-system-inputs.json

FROM system-inputs AS runtime-cli-sandbox-init-builder

# Compile the namespace-PID1 helper outside the final runtime image.  Python's
# stdlib does not expose close_range on every supported image, so this helper
# performs the kernel close_range + post-close descriptor audit before it
# execs any Dashboard CLI-auth payload.
RUN --network=none --mount=from=system-artifacts,source=debs,target=/opt/system-artifacts/debs,readonly \
    python -I /tmp/install_system_artifacts.py \
      --manifest /tmp/debian-system-inputs.json \
      --artifacts /opt/system-artifacts/debs --profile compiler \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb \
    && rm /tmp/install_system_artifacts.py /tmp/debian-system-inputs.json
COPY scripts/runtime_cli_sandbox_init.c /src/runtime_cli_sandbox_init.c
RUN --network=none mkdir -p /out \
    && gcc -O2 -Wall -Wextra -Werror -o /out/runtime-cli-sandbox-init \
    /src/runtime_cli_sandbox_init.c

FROM system-inputs

# Exact runtime profile includes the existing restore/voice tools plus audio
# libraries for explicitly selected live-listener extras. Both Debian profiles
# install only pinned local archives from the complete required public context.
RUN --network=none --mount=from=system-artifacts,source=debs,target=/opt/system-artifacts/debs,readonly \
    python -I /tmp/install_system_artifacts.py \
      --manifest /tmp/debian-system-inputs.json \
      --artifacts /opt/system-artifacts/debs --profile runtime \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb \
    && rm /tmp/install_system_artifacts.py /tmp/debian-system-inputs.json

# The Dashboard itself remains its existing process identity.  This immutable
# marker reserves the outer identities that the CLI-auth sandbox leases one at
# a time; each invocation drops to a member of 61000-61999 before bwrap.
COPY --from=runtime-cli-sandbox-init-builder /out/runtime-cli-sandbox-init /usr/local/libexec/butlers/runtime-cli-sandbox-init
RUN chmod 0755 /usr/local/libexec/butlers/runtime-cli-sandbox-init \
    && mkdir -p /usr/local/share/butlers \
    && printf '%s\n' '61000-61999' > /usr/local/share/butlers/runtime-cli-sandbox-uid-range \
    && chmod 0444 /usr/local/share/butlers/runtime-cli-sandbox-uid-range

# Node.js 22 (for LLM runtime CLIs)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# LLM runtime CLIs — pinned to exact versions for reproducibility.
# NODE_OPTIONS scoped to this RUN only: the Docker build network is IPv4-only,
# but registry.npmjs.org resolves both A/AAAA records, so plain npm install
# hits ECONNRESET on the IPv6 route. Forcing IPv4-first resolution here avoids
# leaking the override into the runtime image's environment.
# To update: bump versions here, verify with `npm view <pkg>@<ver>`, rebuild.
RUN --mount=type=cache,target=/root/.npm \
    NODE_OPTIONS=--dns-result-order=ipv4first npm install -g \
    @anthropic-ai/claude-code@2.1.309 \
    @google/gemini-cli@0.66.0 \
    @openai/codex@0.159.2 \
    opencode-ai@1.17.7

# Resolve the pinned npm launchers and the separately computed PID1 shim
# closure after the final shim install. The version-3 image asset is the sole
# runtime authority for those exact inputs; no later layer replaces the shim.
COPY scripts/generate_runtime_cli_sandbox_manifest.py /tmp/generate_runtime_cli_sandbox_manifest.py
RUN python /tmp/generate_runtime_cli_sandbox_manifest.py \
        --output /usr/local/share/butlers/runtime-cli-sandbox-inputs.json \
    && chmod 0444 /usr/local/share/butlers/runtime-cli-sandbox-inputs.json \
    && rm /tmp/generate_runtime_cli_sandbox_manifest.py

# Emit an auditable CLI version manifest — inspect with:
#   docker run --rm <image> cat /opt/cli-versions.txt
RUN mkdir -p /opt \
    && node --version > /opt/cli-versions.txt \
    && (npm list -g --depth=0 2>/dev/null || true) >> /opt/cli-versions.txt \
    && dpkg-query -W -f='bubblewrap=${Version}\n' bubblewrap >> /opt/cli-versions.txt

# uv package manager. Install into /usr/local/bin and assert the binary exists so
# a transient installer/download problem cannot produce a broken base image.
RUN python -m pip install --no-cache-dir uv \
    && uv --version

WORKDIR /app
