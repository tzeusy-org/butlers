      "contracts": [
        "REQ-ci-shard-assurance-004"
      ],
      "reason": "Require the new inventory prerequisite in full/main-push modes and its explicit skip in scoped/docs modes. Preserve every required verdict and malformed/missing/failure/skip/cancellation control; execute the real Python verdict alongside the actual shell and add the inventory fault control."
    },
    {
      "before": "tests/contracts/test_ci_test_targets.py::test_ci_workflow_shards_full_lanes_without_coverage_or_privacy_drift",
      "after": "tests/contracts/test_ci_test_targets.py::test_ci_workflow_shards_full_lanes_without_coverage_or_privacy_drift",
      "contracts": [
        "REQ-ci-shard-assurance-001",
        "REQ-ci-shard-assurance-004",
        "REQ-ci-shard-assurance-006",
        "REQ-ci-shard-assurance-007",
        "REQ-ci-shard-assurance-008",
        "REQ-testing-034",
        "REQ-testing-049"
      ],
      "reason": "Move full-shard start dependency from guards to fresh inventory while retaining mandatory guards at final fan-in; start affected/Vitest after route, keep browser build binding. Move raw coverage and report expectations to all eleven owned assurance children, retaining ordinary queue evidence, exact reconciliation, smoke, finite caps and main-only scheduled/manual badge publication. The bound companion test_owned_coverage_workflow_retains_complete_assurance exercises actual triggers, rows, artifacts and prerequisite failures."
    },
    {
      "before": "tests/contracts/test_ci_test_targets.py::test_ci_coverage_report_rejects_any_bad_input_before_publication",
      "after": "tests/contracts/test_ci_test_targets.py::test_ci_coverage_report_rejects_any_bad_input_before_publication",
      "contracts": [
        "REQ-ci-shard-assurance-006",
        "REQ-testing-049"
      ],
      "reason": "Select the actual combine/report shell from the owned assurance workflow. Retain all real CoverageData corruption/missing/extra/source/identity negative controls; add genuine per-event traced populations for schedule/manual/PR and refuse cross-event borrowing or unsupported push reporting."
    },
    {
      "before": "tests/scripts/test_ci_partition.py::test_partition_preserves_fresh_membership_with_unknown_weights",
      "after": "tests/scripts/test_ci_partition.py::test_partition_preserves_fresh_membership_with_unknown_weights",
      "contracts": [
        "REQ-ci-shard-assurance-002"
      ],
      "reason": "Evolve _weights to tracer-specific v2 profiles and place malformed/stale fields at their real profile location. Preserve duplicate-key rejection, deterministic advisory fallback, fresh inventory authority, budgets, actual standalone execution and exact assignment membership; _corpus clears inherited tracing flags so explicit profile cases own their instrumentation."
    },
    {
      "before": "tests/scripts/test_ci_partition.py::test_reconciliation_requires_complete_node_identity",
      "after": "tests/scripts/test_ci_partition.py::test_reconciliation_requires_complete_node_identity",
      "contracts": [
        "REQ-ci-shard-assurance-002",
        "REQ-ci-shard-assurance-006"
      ],
      "reason": "Read the real CTracer candidate profile while retaining original origin, config, population, bounded archive, ambiguity and missing-input controls. Add a separately measured untraced profile and reject missing tracer evidence; no covered costs are relabelled as untraced and no membership authority moves to advisory weights."
    }
