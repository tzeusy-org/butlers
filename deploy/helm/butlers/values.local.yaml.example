# Copy to values.local.yaml (gitignored; applied after values.<env>.yaml) and fill in
# the site-specific hosts that the committed values deliberately leave as `.invalid`.
image:
  repository: <registry-host>/butlers-app
frontendImage:
  repository: <registry-host>/butlers-frontend
publicUrl:
  host: <public-dashboard-host>
# Optional: fix the Service ClusterIPs that host `tailscale serve` targets.
# serviceClusterIPs:
#   frontend: <free-cluster-ip-1>
#   dashboardApi: <free-cluster-ip-2>
# Multi-node clusters: keep the pods that host `tailscale serve` targets on the
# serve host's node (tailscaled cannot reach pods across the flannel tunnel).
# hostServedNodeSelector:
#   kubernetes.io/hostname: <serve-host-node>
commonEnv:
  OTEL_EXPORTER_OTLP_ENDPOINT: http://<otel-host>:4318
  # Optional: LIVE_LISTENER_TRANSCRIPTION_URL: tcp://<wyoming-host>:10300
