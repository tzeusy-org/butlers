+#[tokio::test]
+async fn selected_gateway_handshake_keeps_native_key_auth_frames_and_logical_authority() {
+    let listener = TcpListener::bind("127.0.0.1:0").await.expect("listener");
+    let address = listener.local_addr().expect("address");
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.expect("accept");
+        let mut socket = tokio_tungstenite::accept_hdr_async(
+            stream,
+            |request: &Request,
+             response: tokio_tungstenite::tungstenite::handshake::server::Response| {
+                assert_eq!(
+                    request.uri().path_and_query().unwrap().as_str(),
+                    "/_butlers/egress/v1/wss/origin.invalid/443/responses?raw=a%2Fb"
+                );
+                assert_eq!(
+                    request.headers()["host"],
+                    format!("egress-gateway:{}", address.port())
+                );
+                assert_eq!(
+                    request.headers()["authorization"],
+                    "Bearer synthetic-sentinel"
+                );
+                Ok(response)
+            },
+        )
+        .await
+        .expect("gateway handshake");
+        let message = socket.next().await.unwrap().unwrap();
+        assert_eq!(message, Message::Text("request".into()));
+        socket.send(Message::Text("response".into())).await.unwrap();
+        socket.close(None).await.unwrap();
+    });
+    let mut request = "wss://origin.invalid/responses?raw=a%2Fb"
+        .into_client_request()
+        .expect("request");
+    request.headers_mut().insert(
+        "authorization",
+        "Bearer synthetic-sentinel".parse().unwrap(),
+    );
+    let key = request.headers()["sec-websocket-key"].clone();
+    let logical = request.uri().clone();
+    let stream = TcpStream::connect(address).await.unwrap();
+    let (inner, response) = selected_handshake(
+        request,
+        WebSocketConfig::default(),
+        codex_http_client::gateway::GatewayConfig {
+            port: address.port(),
+        },
+        Box::new(stream),
+    )
+    .await
+    .expect("native selected handshake");
+    assert_eq!(
+        logical.to_string(),
+        "wss://origin.invalid/responses?raw=a%2Fb"
+    );
+    assert_eq!(response.status(), 101);
+    assert!(!key.as_bytes().is_empty());
+    let mut socket = WebSocketConnection::new(
+        inner,
+        codex_http_client::NetworkPolicy::unmanaged()
+            .acquire(&url::Url::parse(&logical.to_string()).unwrap())
+            .unwrap(),
+    );
+    socket.send(Message::Text("request".into())).await.unwrap();
+    assert_eq!(
+        socket.next().await.unwrap().unwrap(),
+        Message::Text("response".into())
+    );
+    server.await.unwrap();
+}
