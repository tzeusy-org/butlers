+async fn selected_handshake(
+    mut request: Request,
+    config: WebSocketConfig,
+    gateway: codex_http_client::gateway::GatewayConfig,
+    stream: Box<dyn AsyncIo>,
+) -> Result<(ConnectionInner, Response), WebSocketError> {
+    let logical = url::Url::parse(&request.uri().to_string()).map_err(|_| {
+        WebSocketError::Io(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "invalid selected WebSocket origin",
+        ))
+    })?;
+    codex_http_client::gateway::validate_headers(request.headers(), &logical, true)
+        .map_err(|error| WebSocketError::Io(io::Error::new(io::ErrorKind::InvalidInput, error)))?;
+    let wire = gateway
+        .wire_url(&logical, true)
+        .map_err(WebSocketError::Io)?;
+    *request.uri_mut() = wire.as_str().parse().map_err(|_| {
+        WebSocketError::Io(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "invalid selected WebSocket route",
+        ))
+    })?;
+    request.headers_mut().insert(
+        "host",
+        format!("egress-gateway:{}", gateway.port)
+            .parse()
+            .map_err(|_| {
+                WebSocketError::Io(io::Error::new(
+                    io::ErrorKind::InvalidInput,
+                    "invalid selected WebSocket authority",
+                ))
+            })?,
+    );
+    // A selected ws:// hop uses this already-open internal stream. Origin WSS
+    // TLS belongs to the request-aware gateway; no CONNECT/proxy/direct retry.
+    let (socket, response) =
+        client_async_tls_with_config(request, stream, Some(config), None).await?;
+    Ok((ConnectionInner::Right(socket), response))
+}
