+#[tokio::test]
+async fn selected_gateway_connect_failures_use_bounded_stream_retry_category() {
+    let unavailable = std::net::TcpListener::bind(("127.0.0.1", 0)).unwrap();
+    let address = unavailable.local_addr().unwrap();
+    drop(unavailable);
+    for routed in [false, true] {
+        let error = test_reqwest_client()
+            .get(format!("http://{address}/responses?token=url-secret"))
+            .send()
+            .await
+            .unwrap_err();
+        let selected = crate::HttpError::GatewayUnavailable(error);
+        let mapped = if routed {
+            ReqwestTransport::map_route_aware_error(selected)
+        } else {
+            ReqwestTransport::map_error(selected)
+        };
+        let TransportError::Network(message) = mapped else {
+            panic!(
+                "selected gateway failure must not enter native unbounded ConnectionFailed retries"
+            );
+        };
+        assert_eq!(message, "selected egress gateway unavailable");
+        assert!(!message.contains("url-secret"));
+    }
+}
