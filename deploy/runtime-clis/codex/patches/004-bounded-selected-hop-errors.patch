+#[tokio::test]
+async fn off_mode_tls_connect_error_retains_upstream_connection_category() {
+    for routed in [false, true] {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let server = tokio::spawn(async move {
+            use tokio::io::{AsyncReadExt, AsyncWriteExt};
+            let (mut socket, _) = listener.accept().await.unwrap();
+            let mut hello = [0u8; 1024];
+            assert!(socket.read(&mut hello).await.unwrap() > 0);
+            socket
+                .write_all(b"HTTP/1.1 400 Not TLS\r\nContent-Length: 0\r\n\r\n")
+                .await
+                .unwrap();
+        });
+        let error = reqwest::Client::builder()
+            .no_proxy()
+            .use_rustls_tls()
+            .build()
+            .unwrap()
+            .get(format!("https://{address}/responses?token=url-secret"))
+            .send()
+            .await
+            .unwrap_err();
+        assert!(error.is_connect());
+        assert!(!error.is_timeout());
+        let mapped = if routed {
+            ReqwestTransport::map_route_aware_error(error.into())
+        } else {
+            ReqwestTransport::map_error(error.into())
+        };
+        let TransportError::Connection(error) = mapped else {
+            panic!("off-mode TLS error must retain native connection category")
+        };
+        assert!(!error.to_string().contains("url-secret"));
+        server.await.unwrap();
+    }
+}
