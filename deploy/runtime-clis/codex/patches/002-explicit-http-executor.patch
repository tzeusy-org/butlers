+    #[test]
+    fn configuration_and_logical_wire_mapping_are_closed() {
+        assert!(GatewayConfig::parse(None, None, true).unwrap().is_none());
+        for (mode, address) in [
+            (None, Some("http://egress-gateway:3110")),
+            (Some("request-v1"), None),
+            (Some("request-v1"), Some("http://localhost:3110")),
+            (Some("request-v1"), Some("http://egress-gateway:03110")),
+        ] {
+            assert!(GatewayConfig::parse(mode, address, false).is_err());
+        }
+        let config = GatewayConfig::parse(
+            Some("request-v1"),
+            Some("http://egress-gateway:3110"),
+            false,
+        )
+        .unwrap()
+        .unwrap();
+        for logical in [
+            "https://127.0.0.1/x",
+            "https://[::1]/x",
+            "http://api.openai.com/x",
+            "https://user@api.openai.com/x",
+            "https://api.openai.com/x#fragment",
+        ] {
+            assert!(
+                config
+                    .wire_url(&reqwest::Url::parse(logical).unwrap(), false)
+                    .is_err()
+            );
+        }
+        let logical = reqwest::Url::parse("https://api.openai.com/v1/responses?raw=a%2Fb").unwrap();
+        assert_eq!(
+            config.wire_url(&logical, false).unwrap().as_str(),
+            "http://egress-gateway:3110/_butlers/egress/v1/https/api.openai.com/443/v1/responses?raw=a%2Fb"
+        );
+        assert_eq!(
+            logical.as_str(),
+            "https://api.openai.com/v1/responses?raw=a%2Fb"
+        );
+    }
