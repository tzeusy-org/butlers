+    #[tokio::test]
+    async fn native_request_executor_preserves_logical_stream_and_cookie_identity() {
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let (continue_tx, continue_rx) = tokio::sync::oneshot::channel();
+        let server = tokio::spawn(async move {
+            let (mut socket, _) = listener.accept().await.unwrap();
+            let mut head = Vec::new();
+            while !head.ends_with(b"\r\n\r\n") {
+                head.push(socket.read_u8().await.unwrap());
+            }
+            let head = String::from_utf8(head).unwrap();
+            assert!(head.starts_with(&format!(
+                "POST /_butlers/egress/v1/https/origin.invalid/{}/responses?raw=a%2Fb HTTP/1.1",
+                address.port()
+            )));
+            assert!(head.contains(&format!("host: egress-gateway:{}", address.port())));
+            assert!(head.contains("authorization: Bearer synthetic-sentinel"));
+            assert!(head.contains("cookie: fixture=before"));
+            let mut body = [0; 7];
+            socket.read_exact(&mut body).await.unwrap();
+            assert_eq!(&body, b"request");
+            socket.write_all(b"HTTP/1.1 429 Too Many Requests\r\nConnection: close\r\nContent-Type: text/event-stream\r\nRetry-After: 7\r\nSet-Cookie: fixture=after; Path=/; Secure\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nfirst\r\n").await.unwrap();
+            continue_rx.await.unwrap();
+            socket.write_all(b"6\r\nsecond\r\n0\r\n\r\n").await.unwrap();
+        });
+        let logical = reqwest::Url::parse(&format!(
+            "https://origin.invalid:{}/responses?raw=a%2Fb",
+            address.port()
+        ))
+        .unwrap();
+        let jar: Arc<dyn CookieStore> = Arc::new(reqwest::cookie::Jar::default());
+        let cookie = http::HeaderValue::from_static("fixture=before; Path=/; Secure");
+        jar.set_cookies(&mut std::iter::once(&cookie), &logical);
+        let mut request = reqwest::Request::new(http::Method::POST, logical.clone());
+        request.headers_mut().insert(
+            "authorization",
+            http::HeaderValue::from_static("Bearer synthetic-sentinel"),
+        );
+        *request.body_mut() = Some(reqwest::Body::from("request"));
+        let mut response = synthetic_client(address)
+            .execute(request, Some(&jar))
+            .await
+            .unwrap();
+        assert_eq!(response.url(), &logical);
+        assert_eq!(response.status(), 429);
+        assert_eq!(response.headers()["retry-after"], "7");
+        assert_eq!(response.chunk().await.unwrap().unwrap().as_ref(), b"first");
+        continue_tx.send(()).unwrap();
+        assert_eq!(response.bytes().await.unwrap().as_ref(), b"second");
+        assert_eq!(jar.cookies(&logical).unwrap(), "fixture=after");
+        server.await.unwrap();
+    }
