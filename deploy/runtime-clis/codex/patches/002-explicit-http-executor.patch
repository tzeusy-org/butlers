+//! Explicit selected Butlers request-v1 executor. Logical URLs remain auth and policy identities.
+use reqwest::cookie::CookieStore;
+use std::io;
+use std::net::IpAddr;
+use std::sync::Arc;
+use std::time::Duration;
+
+use http::HeaderMap;
+use reqwest::ResponseBuilderExt;
+
+#[derive(Clone, Debug)]
+pub struct GatewayConfig {
+    pub port: u16,
+}
+
+fn invalid() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::InvalidInput,
+        "invalid selected egress configuration or origin",
+    )
+}
+
+impl GatewayConfig {
+    pub fn from_environment() -> io::Result<Option<Self>> {
+        let mode = std::env::var_os("BUTLERS_EGRESS_MODE");
+        let address = std::env::var_os("BUTLERS_EGRESS_GATEWAY");
+        Self::parse(
+            mode.as_ref().and_then(|v| v.to_str()),
+            address.as_ref().and_then(|v| v.to_str()),
+            mode.is_none() && address.is_none(),
+        )
+    }
+
+    fn parse(mode: Option<&str>, address: Option<&str>, absent: bool) -> io::Result<Option<Self>> {
+        if absent {
+            return Ok(None);
+        }
+        let address = address.ok_or_else(invalid)?;
+        let port = address
+            .strip_prefix("http://egress-gateway:")
+            .ok_or_else(invalid)?;
+        if mode != Some("request-v1")
+            || port.starts_with('0')
+            || !port.bytes().all(|v| v.is_ascii_digit())
+        {
+            return Err(invalid());
+        }
+        let port: u16 = port.parse().map_err(|_| invalid())?;
+        if port < 1024 {
+            return Err(invalid());
+        }
+        Ok(Some(Self { port }))
+    }
+
+    pub fn wire_url(&self, logical: &reqwest::Url, websocket: bool) -> io::Result<reqwest::Url> {
+        let host = logical.host_str().ok_or_else(invalid)?;
+        if logical.scheme() != if websocket { "wss" } else { "https" }
+            || !logical.username().is_empty()
+            || logical.password().is_some()
+            || logical.fragment().is_some()
+            || host.parse::<IpAddr>().is_ok()
+            || host.starts_with('[')
+            || !host.is_ascii()
+            || host.ends_with('.')
+            || host.contains('\\')
+        {
+            return Err(invalid());
+        }
+        let port = logical.port_or_known_default().ok_or_else(invalid)?;
+        let query = logical.query().map(|v| format!("?{v}")).unwrap_or_default();
+        let kind = if websocket { "wss" } else { "https" };
+        let scheme = if websocket { "ws" } else { "http" };
+        reqwest::Url::parse(&format!(
+            "{scheme}://egress-gateway:{}/_butlers/egress/v1/{kind}/{host}/{port}{}{query}",
+            self.port,
+            logical.path()
+        ))
+        .map_err(|_| invalid())
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct GatewayClient {
+    config: GatewayConfig,
+    client: reqwest::Client,
+}
+
+impl GatewayClient {
+    pub(crate) fn from_environment(
+        connect_timeout: Option<Duration>,
+    ) -> Result<Option<Self>, String> {
+        GatewayConfig::from_environment()
+            .map_err(|e| e.to_string())?
+            .map(|config| {
+                let client = reqwest::Client::builder()
+                    .no_proxy()
+                    .http1_only()
+                    .redirect(reqwest::redirect::Policy::none())
+                    .connect_timeout(
+                        connect_timeout
+                            .unwrap_or(Duration::from_secs(10))
+                            .min(Duration::from_secs(10)),
+                    )
+                    .timeout(Duration::from_secs(3600))
+                    .build()
+                    .map_err(|_| "selected egress client construction failed".to_string())?;
+                Ok(Self { config, client })
+            })
+            .transpose()
+    }
+
+    pub(crate) async fn execute(
+        &self,
+        mut request: reqwest::Request,
+        cookies: Option<&Arc<dyn CookieStore>>,
+    ) -> Result<reqwest::Response, crate::HttpError> {
+        let logical = request.url().clone();
+        let wire = self
+            .config
+            .wire_url(&logical, false)
+            .map_err(|e| crate::HttpError::Build(e.to_string()))?;
+        validate_headers(request.headers(), &logical, false)?;
+        if !request.headers().contains_key(http::header::COOKIE) {
+            if let Some(value) = cookies.and_then(|store| store.cookies(&logical)) {
+                request.headers_mut().insert(http::header::COOKIE, value);
+            }
+        }
+        request.headers_mut().remove(http::header::HOST);
+        request.headers_mut().remove(http::header::CONNECTION);
+        request.headers_mut().insert(
+            http::header::CONNECTION,
+            http::HeaderValue::from_static("close"),
+        );
+        *request.version_mut() = http::Version::HTTP_11;
+        *request.url_mut() = wire;
+        let response = self
+            .client
+            .execute(request)
+            .await
+            .map_err(|error| crate::HttpError::Request(error.with_url(logical.clone())))?;
+        if response.status().is_redirection() {
+            return Err(crate::HttpError::Build(
+                "selected egress redirect refused".to_string(),
+            ));
+        }
+        if let Some(store) = cookies {
+            store.set_cookies(
+                &mut response.headers().get_all(http::header::SET_COOKIE).iter(),
+                &logical,
+            );
+        }
+        // Public reqwest conversion retains the streaming body and its cancellation.
+        // Its response URL extension restores the logical identity without buffering.
+        let mut response: http::Response<reqwest::Body> = response.into();
+        let identity = http::Response::builder()
+            .url(logical)
+            .body(())
+            .expect("valid response identity");
+        response
+            .extensions_mut()
+            .extend(identity.into_parts().0.extensions);
+        Ok(response.into())
+    }
+}
+
+pub fn validate_headers(
+    headers: &HeaderMap,
+    logical: &reqwest::Url,
+    websocket: bool,
+) -> Result<(), crate::HttpError> {
+    if headers.get_all(http::header::HOST).iter().count() > 1 {
+        return Err(crate::HttpError::Build(
+            "selected egress duplicate authority".to_string(),
+        ));
+    }
+    if let Some(value) = headers.get(http::header::HOST) {
+        let host = logical.host_str().unwrap_or_default();
+        let authority = format!("{host}:{}", logical.port_or_known_default().unwrap_or(443));
+        if value.as_bytes() != authority.as_bytes()
+            && !(logical.port_or_known_default() == Some(443)
+                && value.as_bytes() == host.as_bytes())
+        {
+            return Err(crate::HttpError::Build(
+                "selected egress origin authority mismatch".to_string(),
+            ));
+        }
+    }
+    for name in headers.keys() {
+        let name = name.as_str();
+        if name == "forwarded"
+            || name.starts_with("x-forwarded-")
+            || name.starts_with("x-egress-")
+            || name.starts_with("x-butlers-")
+            || matches!(
+                name,
+                "proxy-authorization" | "proxy-connection" | "trailer" | "expect"
+            )
+            || (name == "upgrade" && !websocket)
+        {
+            return Err(crate::HttpError::Build(
+                "selected egress header refused".to_string(),
+            ));
+        }
+    }
+    Ok(())
+}
