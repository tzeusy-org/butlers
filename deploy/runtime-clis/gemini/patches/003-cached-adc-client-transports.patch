+/** Selected transport for factory-owned cached ADC clients, including recursive sources. */
+import type { GoogleAuth } from 'google-auth-library';
+import { egressFetch, gatewayConfig } from './butlersEgress.js';
+
+export function fromJSONWithGateway(
+  auth: GoogleAuth,
+  credentials: Parameters<GoogleAuth['fromJSON']>[0],
+): ReturnType<GoogleAuth['fromJSON']> {
+  if (!gatewayConfig()) return auth.fromJSON(credentials);
+  const nativeFromJSON = auth.fromJSON.bind(auth);
+  // GoogleAuth's impersonation parser recursively calls this public method while
+  // ignoring its outer clientOptions. This owned-instance hook reaches each
+  // source client without replacing parsers, credentials, caches or interceptors.
+  auth.fromJSON = (
+    json,
+    options: NonNullable<Parameters<GoogleAuth['fromJSON']>[1]> = {},
+  ) => {
+    const client = nativeFromJSON(json, {
+      ...options,
+      transporterOptions: {
+        ...options.transporterOptions,
+        fetchImplementation: egressFetch,
+      },
+    });
+    // The impersonated outer constructor also ignores fromJSON's options.
+    // Preserve its native transporter/interceptors and set only its fetch default.
+    client.transporter.defaults.fetchImplementation = egressFetch;
+    return client;
+  };
+  return auth.fromJSON(credentials);
+}
