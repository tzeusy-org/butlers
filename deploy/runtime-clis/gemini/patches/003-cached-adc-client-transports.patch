+import { beforeEach, expect, it, vi } from 'vitest';
+import { generateKeyPairSync } from 'node:crypto';
+import { GoogleAuth } from 'google-auth-library';
+import { fromJSONWithGateway } from './butlersGoogleAuth.js';
+
+const state = vi.hoisted(() => ({ selected: true, requests: [] as string[] }));
+vi.mock('./butlersEgress.js', () => ({
+  gatewayConfig: () => (state.selected ? { port: 3115 } : undefined),
+  egressFetch: async (input: string | URL) => {
+    const url = String(input);
+    state.requests.push(url);
+    return new Response(
+      JSON.stringify(
+        url.endsWith(':generateAccessToken')
+          ? {
+              accessToken: 'synthetic-impersonated',
+              expireTime: new Date(Date.now() + 3600000).toISOString(),
+            }
+          : {
+              access_token: 'synthetic-source',
+              expires_in: 3600,
+              token_type: 'Bearer',
+            },
+      ),
+      { status: 200, headers: { 'content-type': 'application/json' } },
+    );
+  },
+}));
+beforeEach(() => {
+  state.selected = true;
+  state.requests.length = 0;
+});
+
+it('actual external-account authorized-user refresh uses selected fetch', async () => {
+  const auth = new GoogleAuth({
+    scopes: ['https://www.googleapis.com/auth/cloud-platform'],
+  });
+  const client = fromJSONWithGateway(auth, {
+    type: 'external_account_authorized_user',
+    client_id: 'synthetic-client',
+    client_secret: 'synthetic-secret',
+    refresh_token: 'synthetic-refresh',
+    token_url: 'https://sts.googleapis.com/v1/oauthtoken',
+  });
+  expect((await client.getAccessToken()).token).toBe('synthetic-source');
+  expect(state.requests).toEqual(['https://sts.googleapis.com/v1/oauthtoken']);
+});
+
+it('actual impersonation refresh keeps both source and target transports selected', async () => {
+  const auth = new GoogleAuth({
+    scopes: ['https://www.googleapis.com/auth/cloud-platform'],
+  });
+  const client = fromJSONWithGateway(auth, {
+    type: 'impersonated_service_account',
+    source_credentials: {
+      type: 'authorized_user',
+      client_id: 'synthetic-client',
+      client_secret: 'synthetic-secret',
+      refresh_token: 'synthetic-refresh',
+    },
+    service_account_impersonation_url:
+      'https://iamcredentials.googleapis.com/v1/projects/-/serviceAccounts/fixture@fixture.iam.gserviceaccount.com:generateAccessToken',
+  });
+  expect((await client.getAccessToken()).token).toBe('synthetic-impersonated');
+  expect(state.requests).toHaveLength(2);
+  expect(state.requests[0]).toBe('https://oauth2.googleapis.com/token');
+  expect(state.requests[1]).toContain('iamcredentials.googleapis.com');
+});
+
+it('off mode keeps the original fromJSON method and native transporter default', () => {
+  state.selected = false;
+  const auth = new GoogleAuth();
+  const nativeFromJSON = auth.fromJSON;
+  const client = fromJSONWithGateway(auth, {
+    type: 'authorized_user',
+    client_id: 'synthetic-client',
+    client_secret: 'synthetic-secret',
+    refresh_token: 'synthetic-refresh',
+  });
+  expect(auth.fromJSON).toBe(nativeFromJSON);
+  expect(client.transporter.defaults.fetchImplementation).toBeUndefined();
+  expect(state.requests).toEqual([]);
+});
+
+it('actual service-account JWT refresh uses selected fetch', async () => {
+  const { privateKey } = generateKeyPairSync('rsa', { modulusLength: 2048 });
+  const auth = new GoogleAuth({
+    scopes: ['https://www.googleapis.com/auth/cloud-platform'],
+  });
+  const client = fromJSONWithGateway(auth, {
+    type: 'service_account',
+    client_email: 'fixture@fixture.iam.gserviceaccount.com',
+    private_key: privateKey.export({ type: 'pkcs8', format: 'pem' }).toString(),
+  });
+  expect((await client.getAccessToken()).token).toBe('synthetic-source');
+  expect(state.requests).toEqual(['https://oauth2.googleapis.com/token']);
+});
