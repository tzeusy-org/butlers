--- a/packages/llm/test/gateway-websocket-errors.test.ts
+++ b/packages/llm/test/gateway-websocket-errors.test.ts
@@ -412,0 +413,133 @@
+
+const credentialMarkers = {
+  user: "synthetic-user:name",
+  password: "synthetic-password:/with-symbols",
+  fragment: "synthetic-private-fragment",
+}
+function assertNoCredentials(value: unknown) {
+  const serialized = JSON.stringify(value)
+  for (const marker of Object.values(credentialMarkers)) {
+    expect(serialized.includes(marker)).toBe(false)
+    expect(serialized.includes(encodeURIComponent(marker))).toBe(false)
+  }
+}
+for (const variant of ["plain", "encoded", "malformed-percent", "fragment"] as const)
+  test(`selected refused ${variant} URL retains safe origin and no credential identity`, async () => {
+    process.env.BUTLERS_EGRESS_MODE = "request-v1"
+    process.env.BUTLERS_EGRESS_GATEWAY = "http://egress-gateway:3115"
+    const user =
+      variant === "encoded" ? encodeURIComponent(credentialMarkers.user) : credentialMarkers.user.replace(":", "-")
+    const password =
+      variant === "encoded"
+        ? encodeURIComponent(credentialMarkers.password)
+        : credentialMarkers.password.replace(":/", "-")
+    const credentials =
+      variant === "fragment" ? "" : `${user}:${password}${variant === "malformed-percent" ? "%ZZ" : ""}@`
+    const url = `wss://${credentials}api.openai.com/v1/responses?api_key=${markers.query}&model=retained-model${variant === "fragment" ? "#" + credentialMarkers.fragment : ""}`
+    const error = await Effect.runPromise(open({ url, headers: Headers.empty }).pipe(Effect.flip))
+    assertNoCredentials({ error, cause: error.cause, message: error.message })
+    const serialized = JSON.stringify({ error, cause: error.cause, message: error.message })
+    const original = new URL(url)
+    for (const value of [original.username, original.password]) {
+      if (!value) continue
+      expect(serialized.includes(value)).toBe(false)
+      try {
+        expect(serialized.includes(decodeURIComponent(value))).toBe(false)
+      } catch (cause) {
+        if (!(cause instanceof URIError)) throw cause
+      }
+    }
+    assertSanitized(error, "open")
+    const safe = new URL((error.reason as any).url)
+    expect(safe.hostname).toBe("api.openai.com")
+    expect(safe.username === "" && safe.password === "" && safe.hash === "").toBe(true)
+    expect(error.method).toBe("open")
+  })
+test("selected credential echoes use real production context and preserve benign metadata", () => {
+  process.env.BUTLERS_EGRESS_MODE = "request-v1"
+  process.env.BUTLERS_EGRESS_GATEWAY = "http://egress-gateway:3115"
+  const url = `wss://${encodeURIComponent(credentialMarkers.user)}:${encodeURIComponent(credentialMarkers.password)}@api.openai.com/v1/responses?api_key=${markers.query}&model=retained-model#${credentialMarkers.fragment}`
+  const echoes = Object.values(credentialMarkers)
+    .flatMap((value) => [value, encodeURIComponent(value)])
+    .join(" ")
+  const input = { url, headers: Headers.fromInput({ "x-safe": "visible" }) }
+  const identity = RequestExecutor.transportFailureIdentity(input, `failed ${url} ${echoes}`, [])
+  const details = RequestExecutor.transportFailureDetails(
+    input,
+    {
+      status: 401,
+      headers: { "retry-after": "3", "x-safe": "visible", "x-echo": echoes },
+      body: JSON.stringify({
+        message: "retained-body",
+        echo: echoes,
+        username: credentialMarkers.user,
+        password: credentialMarkers.password,
+      }),
+      truncated: false,
+    },
+    [],
+  )
+  assertNoCredentials({ identity, details })
+  expect(details.http.response?.status).toBe(401)
+  expect(details.http.response?.headers["retry-after"]).toBe("3")
+  expect(details.http.response?.headers["x-safe"]).toBe("visible")
+  expect(details.http.body?.includes("retained-body")).toBe(true)
+  expect(details.http.bodyTruncated).toBe(false)
+  expect(new URL(details.url).hostname).toBe("api.openai.com")
+  expect(new URL(details.url).searchParams.get("model")).toBe("retained-model")
+  expect(identity.message.includes("<redacted>")).toBe(true)
+})
+test("selected explicitly named short credentials redact without broad substring scrubbing", () => {
+  process.env.BUTLERS_EGRESS_MODE = "request-v1"
+  process.env.BUTLERS_EGRESS_GATEWAY = "http://egress-gateway:3115"
+  const input = { url: "wss://u:p@api.openai.com/v1/responses?password=p&model=retained-model", headers: Headers.empty }
+  const result = RequestExecutor.transportFailureDetails(
+    input,
+    {
+      status: 401,
+      headers: { username: "u", password: "p", "x-safe": "unchanged" },
+      body: JSON.stringify({ username: "u", password: "p", message: "useful companion" }),
+      truncated: false,
+    },
+    [],
+  )
+  const url = new URL(result.url)
+  expect(url.username === "" && url.password === "").toBe(true)
+  expect(url.searchParams.get("password") === "<redacted>").toBe(true)
+  const body = JSON.parse(result.http.body!)
+  expect(body.username === "<redacted>" && body.password === "<redacted>").toBe(true)
+  expect(body.message).toBe("useful companion")
+  expect(result.http.response?.headers.username === "<redacted>").toBe(true)
+  expect(result.http.response?.headers.password === "<redacted>").toBe(true)
+  expect(result.http.response?.headers["x-safe"]).toBe("unchanged")
+})
+test("native off-mode typed identity and HTTP diagnostics retain their prior userinfo behavior", async () => {
+  const { http, port } = await server()
+  const wss = new WebSocketServer({ server: http })
+  cleanup.push(async () => {
+    for (const peer of wss.clients) peer.terminate()
+    await new Promise<void>((resolve) => wss.close(() => resolve()))
+  })
+  const native = new WebSocket(`ws://127.0.0.1:${port}/native`)
+  const closed = new Promise<void>((resolve) => native.addEventListener("close", () => resolve(), { once: true }))
+  await new Promise<void>((resolve) => native.addEventListener("open", () => resolve(), { once: true }))
+  native.close(1000)
+  await closed
+  // The exposed fromWebSocket API retains the supplied logical identity off-mode.
+  const url = `wss://${encodeURIComponent(credentialMarkers.user)}:${encodeURIComponent(credentialMarkers.password)}@api.openai.com/v1/responses?model=retained-model`
+  const input = { url, headers: Headers.empty }
+  const error = await Effect.runPromise(fromWebSocket(native, input).pipe(Effect.flip))
+  expect((error.reason as any).url === url).toBe(true)
+  const details = RequestExecutor.transportFailureDetails(
+    input,
+    {
+      status: 401,
+      headers: { username: "u", password: "p" },
+      body: JSON.stringify({ username: "u", password: "p", message: "retained" }),
+      truncated: false,
+    },
+    [],
+  )
+  expect(details.url === url).toBe(true)
+  expect(JSON.parse(details.http.body!).password === "p").toBe(true)
+})
