+import fs from "node:fs/promises"
+import path from "node:path"
+
+/** Explicit complete offline inputs never fall back to a live catalogue or logo. */
+export async function writeProviderIcons(input: {
+  catalogue?: string
+  logos?: string
+  baseURL: string
+  output: string
+}) {
+  if (Boolean(input.catalogue) !== Boolean(input.logos))
+    throw new Error("Local models catalogue and complete logo directory must be supplied together")
+  const catalogue = input.catalogue
+    ? JSON.parse(await fs.readFile(input.catalogue, "utf8"))
+    : await fetch(`${input.baseURL}/api.json`).then((response) => {
+        if (!response.ok) throw new Error("models.dev catalogue request failed")
+        return response.json()
+      })
+  if (catalogue === null || typeof catalogue !== "object" || Array.isArray(catalogue))
+    throw new Error("Invalid models.dev provider catalogue")
+  const providers = Object.keys(catalogue)
+  if (providers.length === 0 || providers.some((provider) => !/^[a-zA-Z0-9._-]+$/.test(provider)))
+    throw new Error("Invalid models.dev provider catalogue")
+  // Read every input before writing; a partial set is not a full UI population.
+  const logos = await Promise.all(providers.map(async (provider) => {
+    const svg = input.logos
+      ? await fs.readFile(path.join(input.logos, `${provider}.svg`), "utf8")
+      : await fetch(`${input.baseURL}/logos/${provider}.svg`).then((response) => {
+          if (!response.ok) throw new Error(`models.dev logo request failed for ${provider}`)
+          return response.text()
+        })
+    if (!svg.trim()) throw new Error(`Empty provider logo: ${provider}`)
+    return { provider, svg }
+  }))
+  await Promise.all(logos.map(({ provider, svg }) => fs.writeFile(path.join(input.output, `${provider}.svg`), svg)))
+  return providers.length
+}
