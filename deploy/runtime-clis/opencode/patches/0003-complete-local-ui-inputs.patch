+import { expect, test } from "bun:test"
+import fs from "node:fs/promises"
+import os from "node:os"
+import path from "node:path"
+import { writeProviderIcons } from "./provider-icons"
+
+test("explicit local full catalogue and logos do not contact the network", async () => {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "provider-icons-"))
+  try {
+    const catalogue = path.join(root, "api.json")
+    const logos = path.join(root, "logos")
+    const output = path.join(root, "output")
+    await fs.mkdir(logos); await fs.mkdir(output)
+    await fs.writeFile(catalogue, JSON.stringify({ alpha: { models: { retained: {} } }, beta: { models: {} } }))
+    await fs.writeFile(path.join(logos, "alpha.svg"), "<svg>alpha</svg>")
+    await fs.writeFile(path.join(logos, "beta.svg"), "<svg>beta</svg>")
+    const input = { catalogue, logos, output, baseURL: "http://127.0.0.1:1/no-fallback" }
+    expect(await writeProviderIcons(input)).toBe(2)
+    expect(await fs.readFile(path.join(output, "alpha.svg"), "utf8")).toBe("<svg>alpha</svg>")
+    await expect(writeProviderIcons({ ...input, logos: undefined })).rejects.toThrow("supplied together")
+    await fs.unlink(path.join(logos, "beta.svg"))
+    await expect(writeProviderIcons(input)).rejects.toThrow()
+    await fs.writeFile(path.join(logos, "beta.svg"), "  ")
+    await expect(writeProviderIcons(input)).rejects.toThrow("Empty provider logo")
+    await fs.writeFile(catalogue, JSON.stringify({ "../foreign": {} }))
+    await expect(writeProviderIcons(input)).rejects.toThrow("Invalid models.dev")
+  } finally { await fs.rm(root, { recursive: true, force: true }) }
+})
