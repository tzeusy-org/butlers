+  { label: "newline-query", secret: "synthetic-prefix\ncredential-tail", where: "query" },
+  { label: "tab-query", secret: "synthetic-prefix\tcredential-tail", where: "query" },
+  { label: "literal-Unicode companion", secret: "synthetic-é-credential-tail", where: "query" },
+  { label: "escaped-Unicode-query", secret: "synthetic-é-credential-tail", where: "query", unicode: true },
+] as const
+for (const sample of jsonEchoCases)
+  test(`selected JSON credential echo ${sample.label} uses actual HttpContext and safe metadata`, () => {
+    process.env.BUTLERS_EGRESS_MODE = "request-v1"
+    process.env.BUTLERS_EGRESS_GATEWAY = "http://egress-gateway:3115"
+    const url = new URL("wss://api.openai.com/v1/responses?model=retained-model")
+    const headers =
+      sample.where === "header" ? Headers.fromInput({ authorization: `Bearer ${sample.secret}` }) : Headers.empty
+    if (sample.where === "query") url.searchParams.set("api_key", sample.secret)
+    let body = JSON.stringify({ password: sample.secret, echo: sample.secret, message: "retained-json-body" })
+    if ("unicode" in sample) body = body.replaceAll("é", "\\u00e9")
+    const input = { url: url.toString(), headers }
+    const result = RequestExecutor.transportFailureDetails(
+      input,
+      {
+        status: 401,
+        headers: { "retry-after": "3", "x-safe": "visible", "x-echo": body },
+        body,
+        truncated: false,
+      },
+      [],
+    )
+    const identity = RequestExecutor.transportFailureIdentity(input, body, [])
+    const decoded = JSON.parse(result.http.body!)
+    expect(decoded.echo === "<redacted>").toBe(true)
+    expect(decoded.password === "<redacted>").toBe(true)
+    expect(JSON.parse(identity.message).echo === "<redacted>").toBe(true)
+    expect(JSON.parse(result.http.response!.headers["x-echo"]).echo === "<redacted>").toBe(true)
+    expect(decoded.message).toBe("retained-json-body")
