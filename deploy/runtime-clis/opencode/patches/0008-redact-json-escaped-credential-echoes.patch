+) => {
+  const values = Array.from(secretValues(request, redactedNames))
+  const redactKnown = (text: string) => values.reduce((value, secret) => value.split(secret).join(REDACTED), text)
+  const selected = selectedDiagnostics()
+  // Short known values are sensitive as whole JSON strings, not as arbitrary
+  // substrings in otherwise benign diagnostic prose.
+  const exactValues = selected ? secretValues(request, redactedNames, 1) : undefined
+  const structured = selected
+    ? body
+        .replace(JSON_STRING_FIELD, (match, key: string, separator: string) =>
+          SELECTED_JSON_FIELD_NAME.test(JSON.parse(key)) ? `${key}${separator}${JSON.stringify(REDACTED)}` : match,
+        )
+        .replace(new RegExp(JSON_STRING_TOKEN_SOURCE, "g"), (token) => {
+          const value: string = JSON.parse(token)
+          const masked = exactValues?.has(value) ? REDACTED : redactKnown(value)
+          return masked === value ? token : JSON.stringify(masked)
+        })
+    : body.replace(REDACT_JSON_FIELD, `$1"${REDACTED}"`)
+  return redactKnown(structured.replace(selected ? REDACT_SELECTED_QUERY_FIELD : REDACT_QUERY_FIELD, `$1${REDACTED}`))
