+async function selectedInput() {
+  return {
+    url: `wss://api.openai.com/v1/responses?api_key=${markers.query}&model=retained-model`,
+    headers: await Effect.runPromise(
+      Auth.toEffect(Auth.bearer(markers.bearer))({
+        request: {} as any,
+        method: "GET",
+        url: "https://api.openai.com/v1/responses",
+        body: "",
+        headers: Headers.fromInput({ "x-safe": "visible" }),
+      }),
+    ),
+  }
+}
+function assertSanitized(error: LLMError, kind: string) {
+  const serialized = JSON.stringify({ error, cause: error.cause, message: error.message })
+  for (const marker of Object.values(markers)) expect(serialized.includes(marker)).toBe(false)
+  expect(error).toBeInstanceOf(LLMError)
+  expect(error.reason._tag).toBe("Transport")
+  expect(error.reason.kind).toBe(kind)
+  expect(error.cause === error.reason).toBe(true)
+  expect(error.retryable).toBe(false)
+  const url = new URL((error.reason as any).url)
+  expect(url.pathname).toBe("/v1/responses")
+  expect(url.searchParams.get("model")).toBe("retained-model")
+  expect(url.searchParams.get("api_key") === "<redacted>").toBe(true)
+}
+for (const variant of ["timeout", "refused", "close-before-open", "already-closed"] as const)
+  test(`selected ${variant} uses sanitized actual Effect error identity`, async () => {
+    const { http, port } = await server()
+    process.env.BUTLERS_EGRESS_MODE = "request-v1"
+    process.env.BUTLERS_EGRESS_GATEWAY = `http://egress-gateway:${port}`
+    const input = await selectedInput()
+    let seen = 0
+    http.on("upgrade", (_request, socket) => {
+      seen++
+      if (variant === "close-before-open") socket.end()
+    })
+    let selectLookup = lookup
+    if (variant === "refused") {
+      // Use a genuinely closed owned loopback port, not a fake socket/error.
+      const probe = createServer()
+      await new Promise<void>((resolve) => probe.listen(0, "127.0.0.1", resolve))
+      const closedPort = (probe.address() as { port: number }).port
+      await new Promise<void>((resolve) => probe.close(() => resolve()))
+      process.env.BUTLERS_EGRESS_GATEWAY = `http://egress-gateway:${closedPort}`
+    }
+    const socket = createGatewayWebSocket({ lookup: selectLookup })(input.url, input.headers, 100)!
+    const closed = new Promise<void>((resolve) => socket.once("close", resolve))
+    const error = await Effect.runPromise(fromWebSocket(socket as any, input).pipe(Effect.flip))
+    await closed
+    assertSanitized(error, "open")
+    expect(seen).toBe(variant === "refused" ? 0 : 1)
+    if (variant === "already-closed") {
+      const repeated = await Effect.runPromise(fromWebSocket(socket as any, input).pipe(Effect.flip))
+      assertSanitized(repeated, "open")
+    }
+  })
