+for (const variant of ["error", "abnormal-close", "unsupported-message", "send", "closing"] as const)
+  test(`selected actual socket ${variant} retains sanitized typed diagnostics`, async () => {
+    const { http, port } = await server()
+    process.env.BUTLERS_EGRESS_MODE = "request-v1"
+    process.env.BUTLERS_EGRESS_GATEWAY = `http://egress-gateway:${port}`
+    const wss = new WebSocketServer({ server: http })
+    cleanup.push(async () => {
+      for (const peer of wss.clients) peer.terminate()
+      await new Promise<void>((resolve) => wss.close(() => resolve()))
+    })
+    let peer: import("butlers-egress-ws").default | undefined
+    wss.on("connection", (value) => {
+      peer = value
+      value.on("message", (data) => value.send(data.toString()))
+    })
+    const input = await selectedInput()
+    const socket = createGatewayWebSocket({ lookup })(input.url, input.headers, 500)!
+    const closed = new Promise<void>((resolve) => socket.once("close", resolve))
+    const connection = await Effect.runPromise(fromWebSocket(socket as any, input))
+    try {
+      // Healthy selected upgrade/frames are a companion to each error branch.
+      await Effect.runPromise(connection.sendText("benign-frame"))
+      const received = await Effect.runPromise(Stream.runHead(connection.messages))
+      expect(Option.getOrThrow(received)).toBe("benign-frame")
+      let error: LLMError
+      if (variant === "send") {
+        // Real ws rejects a non-wire-representable send argument; no method mock.
+        error = await Effect.runPromise(connection.sendText(Symbol("invalid") as any).pipe(Effect.flip))
+      } else if (variant === "closing") {
+        socket.close(1000)
+        expect(socket.readyState).toBe(WebSocket.CLOSING)
+        error = await Effect.runPromise(fromWebSocket(socket as any, input).pipe(Effect.flip))
+      } else {
+        if (variant === "abnormal-close") peer!.close(1011, "benign-close")
+        if (variant === "error") socket.emit("error", new Error(`synthetic-event ${markers.query}`))
+        if (variant === "unsupported-message") socket.emit("message", { unsupported: true }, true)
+        error = await Effect.runPromise(Stream.runDrain(connection.messages).pipe(Effect.flip))
+      }
+      assertSanitized(
+        error,
+        variant === "send"
+          ? "write"
+          : variant === "closing"
+            ? "open"
+            : variant === "abnormal-close"
+              ? "close"
+              : "message",
+      )
+    } finally {
+      await Effect.runPromise(connection.close)
+      socket.terminate()
+      await closed
+    }
+  })
