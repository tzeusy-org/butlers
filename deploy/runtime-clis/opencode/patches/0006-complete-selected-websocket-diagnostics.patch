+/** Sanitize selected non-HTTP transport identity with the same request-secret rules. */
+export const transportFailureIdentity = (
+  input: { readonly url: string; readonly headers: Headers.Headers },
+  message: string,
+  redactedNames: ReadonlyArray<string | RegExp>,
+) => {
+  const request = HttpClientRequest.get(input.url).pipe(HttpClientRequest.setHeaders(input.headers))
+  const url = redactBody(redactUrl(input.url), request, redactedNames)
+  return {
+    url,
+    // Invalid URL construction can include the entire supplied value in its
+    // message. Replace it before field/literal sanitizing, even when unparseable.
+    message: redactBody(message.split(input.url).join(url), request, redactedNames),
+  }
+}
