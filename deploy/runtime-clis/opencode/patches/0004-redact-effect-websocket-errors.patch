+/** Reuse HTTP redaction before a second authenticated transport constructs typed diagnostics. */
+export const transportFailureDetails = (
+  input: { readonly url: string; readonly headers: Headers.Headers },
+  response: {
+    readonly status: number
+    readonly headers: Record<string, string>
+    readonly body: string
+    readonly truncated: boolean
+  },
+  redactedNames: ReadonlyArray<string | RegExp>,
+) => {
+  const request = HttpClientRequest.get(input.url).pipe(HttpClientRequest.setHeaders(input.headers))
+  const redact = (value: string) => redactBody(value, request, redactedNames)
+  const headers = (value: Headers.Headers) =>
+    Object.fromEntries(
+      Object.entries(redactHeaders(value, redactedNames)).map(([name, value]) => [name, redact(value)]),
+    )
+  const url = redact(redactUrl(input.url))
+  return {
+    url,
+    http: new HttpContext({
+      request: new HttpRequestDetails({ method: "GET", url, headers: headers(input.headers) }),
+      response: new HttpResponseDetails({
+        status: response.status,
+        headers: headers(Headers.fromInput(response.headers)),
+      }),
+      // The connector has already enforced its 64KiB/10s body bound. Preserve
+      // that truncation signal while sanitizing, rather than buffering again.
+      body: redact(response.body),
+      bodyTruncated: response.truncated,
+    }),
+  }
+}
