+import { afterEach, expect, test } from "bun:test"
+import { createServer } from "node:net"
+import { once } from "node:events"
+import WebSocket, { WebSocketServer } from "butlers-egress-ws"
+import { createGatewayWebSocket, gatewayHandshakeError, logicalWebSocketURL } from "../src/route/gateway-websocket"
+
+const lookup = (_host: string, options: any, callback: any) => {
+  if (options?.all) callback(null, [{ address: "127.0.0.1", family: 4 }])
+  else callback(null, "127.0.0.1", 4)
+}
+const logical = "wss://api.openai.com/v1/responses?model=synthetic"
+const cleanup: Array<() => Promise<void>> = []
+afterEach(async () => {
+  delete process.env.BUTLERS_EGRESS_MODE
+  delete process.env.BUTLERS_EGRESS_GATEWAY
+  for (const close of cleanup.splice(0).reverse()) await close()
+})
+async function server() {
+  // Raw loopback HTTP/1 avoids Bun's own HTTP-server upgrade adapter, so
+  // controls exercise the actual client transport and pinned ws frame engine.
+  const sockets = new Set<import("node:net").Socket>()
+  const http = createServer((socket) => {
+    sockets.add(socket)
+    socket.once("close", () => sockets.delete(socket))
+    let pending = Buffer.alloc(0)
+    const read = (chunk: Buffer) => {
+      pending = Buffer.concat([pending, chunk])
+      const end = pending.indexOf("\r\n\r\n")
+      if (end < 0) return
+      socket.off("data", read)
+      const lines = pending.subarray(0, end).toString().split("\r\n")
+      const [method, url] = lines.shift()!.split(" ")
+      const headers = Object.fromEntries(lines.map((line) => {
+        const colon = line.indexOf(":")
+        return [line.slice(0, colon).toLowerCase(), line.slice(colon + 1).trim()]
+      }))
+      http.emit("upgrade", { method, url, headers, socket }, socket, pending.subarray(end + 4))
+    }
+    socket.on("data", read)
+  })
+  await new Promise<void>((resolve) => http.listen(0, "127.0.0.1", resolve))
+  const address = http.address() as { port: number }
+  process.env.BUTLERS_EGRESS_MODE = "request-v1"
+  process.env.BUTLERS_EGRESS_GATEWAY = `http://egress-gateway:${address.port}`
+  cleanup.push(async () => { for (const socket of sockets) socket.destroy(); await new Promise<void>((resolve) => http.close(() => resolve())) })
+  return http
+}
+for (const status of [401, 429, 302, 307]) {
+  test(`selected real handshake preserves/refuses status ${status} without a second origin`, async () => {
+    const http = await server()
+    let requests = 0
+    http.on("upgrade", (request, socket) => {
+      requests++
+      expect(request.url).toBe("/_butlers/egress/v1/wss/api.openai.com/443/v1/responses?model=synthetic")
+      expect(request.headers.authorization).toBe("Bearer synthetic")
+      const body = (status < 300 || status > 399) ? '{"error":"synthetic"}' : "never-expose-redirect"
+      socket.end(`HTTP/1.1 ${status} Synthetic\r\nContent-Length: ${body.length}\r\nRetry-After: 3\r\nLocation: ws://127.0.0.1/forbidden\r\nConnection: close\r\n\r\n${body}`)
+    })
+    const ws = createGatewayWebSocket({ lookup })(logical, { authorization: "Bearer synthetic" }, 500)!
+    const closed = new Promise<void>((resolve) => ws.once("close", () => resolve()))
+    const error = await new Promise<Error>((resolve) => ws.once("error", resolve))
+    await closed
+    const receipt = gatewayHandshakeError(ws)!
+    expect(error).toBe(receipt)
+    expect(logicalWebSocketURL(ws)).toBe(logical)
+    expect(requests).toBe(1)
+    expect(receipt.status).toBe((status >= 300 && status <= 399) ? 403 : status)
+    expect(receipt.headers["retry-after"]).toBe((status >= 300 && status <= 399) ? undefined : "3")
+    expect(receipt.headers.location).toBeUndefined()
+    expect(receipt.body).toBe((status >= 300 && status <= 399) ? "Selected egress request refused" : '{"error":"synthetic"}')
+    expect(ws.readyState).toBe(WebSocket.CLOSED)
+  })
+}
+test("selected healthy socket preserves real frames/protocol identity and off-mode stays absent", async () => {
+  const http = await server()
+  const wss = new WebSocketServer({ server: http })
+  cleanup.push(async () => { for (const client of wss.clients) client.terminate(); await new Promise<void>((resolve) => wss.close(() => resolve())) })
+  wss.on("connection", (ws, request) => {
+    expect(request.headers["openai-beta"]).toBe("synthetic-protocol")
+    ws.on("message", (message) => ws.send(message.toString()))
+  })
+  const ws = createGatewayWebSocket({ lookup })(logical, { "openai-beta": "synthetic-protocol" })!
+  await once(ws, "open")
+  const received = once(ws, "message")
+  ws.send("retained-frame")
+  expect((await received)[0].toString()).toBe("retained-frame")
+  expect(logicalWebSocketURL(ws)).toBe(logical)
+  const closed = once(ws, "close"); ws.close(1000, "done"); await closed
+  delete process.env.BUTLERS_EGRESS_MODE; delete process.env.BUTLERS_EGRESS_GATEWAY
+  expect(createGatewayWebSocket({ lookup })(logical, {})).toBeUndefined()
+})
+test("selected unfinished/oversized error body is bounded and cancellation closes pending handshake", async () => {
+  const http = await server()
+  const sockets = new Set<import("node:net").Socket>()
+  http.on("connection", (socket) => { sockets.add(socket); socket.once("close", () => sockets.delete(socket)) })
+  cleanup.push(async () => { for (const socket of sockets) socket.destroy() })
+  http.on("upgrade", (_request, socket) => socket.write("HTTP/1.1 429 Slow\r\nTransfer-Encoding: chunked\r\n\r\n10001\r\n" + "x".repeat(65537) + "\r\n"))
+  const ws = createGatewayWebSocket({ lookup })(logical, {}, 80)!
+  const close = new Promise<void>((resolve) => ws.once("close", () => resolve()))
+  await new Promise<void>((resolve) => ws.once("error", () => resolve())); await close
+  expect(gatewayHandshakeError(ws)?.truncated).toBe(true)
+  expect(Buffer.byteLength(gatewayHandshakeError(ws)!.body)).toBeLessThanOrEqual(65536)
+  const pending = createGatewayWebSocket({ lookup })(logical, {}, 100)!
+  const stopped = new Promise<void>((resolve) => pending.once("close", () => resolve()))
+  pending.terminate(); await stopped
+  expect(pending.readyState).toBe(WebSocket.CLOSED)
+})
+
+for (const accept of ["wrong-accept", "duplicate"]) {
+  test(`selected upgrade retains ws handshake validation: ${accept}`, async () => {
+    const http = await server()
+    http.on("upgrade", (_request, socket) => socket.end(
+      "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n" +
+      "Sec-WebSocket-Accept: invalid\r\n" +
+      (accept === "duplicate" ? "Sec-WebSocket-Accept: invalid-again\r\n" : "") + "\r\n",
+    ))
+    const ws = createGatewayWebSocket({ lookup })(logical, {}, 500)!
+    const closed = new Promise<void>((resolve) => ws.once("close", () => resolve()))
+    const error = await new Promise<Error>((resolve) => ws.once("error", resolve))
+    await closed
+    expect(error.message).toContain("Invalid Sec-WebSocket-Accept")
+    expect(ws.readyState).toBe(WebSocket.CLOSED)
+    expect(gatewayHandshakeError(ws)).toBeUndefined()
+  })
+}
+
+test("selected unresponsive handshake retains a bounded absolute opening timeout", async () => {
+  const http = await server()
+  http.on("upgrade", () => {})
+  const ws = createGatewayWebSocket({ lookup })(logical, {}, 50)!
+  const closed = new Promise<void>((resolve) => ws.once("close", () => resolve()))
+  const started = performance.now()
+  const error = await new Promise<Error>((resolve) => ws.once("error", resolve))
+  await closed
+  expect(error).toBeInstanceOf(Error)
+  expect(performance.now() - started).toBeLessThan(1000)
+  expect(ws.readyState).toBe(WebSocket.CLOSED)
+})
