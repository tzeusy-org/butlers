+import { expect, test } from "bun:test"
+import { Effect } from "effect"
+import { HttpClient } from "effect/unstable/http"
+import { gatewayHttpLayer } from "../src/route/egress"
+
+test("Effect Fetch reference preserves native off-mode and fails selected config before native fetch", async () => {
+  const native = globalThis.fetch
+  const mode = process.env.BUTLERS_EGRESS_MODE
+  const address = process.env.BUTLERS_EGRESS_GATEWAY
+  const calls: string[] = []
+  globalThis.fetch = (async (input: RequestInfo | URL) => {
+    calls.push(input instanceof Request ? input.url : String(input))
+    return new Response("retained-native", { status: 200 })
+  }) as typeof fetch
+  try {
+    delete process.env.BUTLERS_EGRESS_MODE
+    delete process.env.BUTLERS_EGRESS_GATEWAY
+    const response = await Effect.runPromise(HttpClient.get("https://api.openai.com/native").pipe(
+      Effect.provide(gatewayHttpLayer),
+    ))
+    expect(await Effect.runPromise(response.text)).toBe("retained-native")
+    expect(calls).toEqual(["https://api.openai.com/native"])
+    process.env.BUTLERS_EGRESS_MODE = "request-v1"
+    process.env.BUTLERS_EGRESS_GATEWAY = "http://foreign:18080"
+    await expect(Effect.runPromise(HttpClient.get("https://api.openai.com/refused").pipe(
+      Effect.provide(gatewayHttpLayer),
+    ))).rejects.toThrow()
+    expect(calls).toEqual(["https://api.openai.com/native"])
+  } finally {
+    globalThis.fetch = native
+    if (mode === undefined) delete process.env.BUTLERS_EGRESS_MODE
+    else process.env.BUTLERS_EGRESS_MODE = mode
+    if (address === undefined) delete process.env.BUTLERS_EGRESS_GATEWAY
+    else process.env.BUTLERS_EGRESS_GATEWAY = address
+  }
+})
