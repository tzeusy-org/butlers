+/// <reference path="../ws-private.d.ts" />
+/// <reference path="../undici-private.d.ts" />
+import WebSocket from "butlers-egress-ws"
+import type { LookupFunction } from "node:net"
+import { PassThrough } from "node:stream"
+import type { ClientRequest, IncomingMessage } from "node:http"
+import Agent from "butlers-egress-undici/lib/dispatcher/agent.js"
+import { gatewayWebSocket } from "../butlers-egress"
+
+const logicalURLs = new WeakMap<WebSocket, string>()
+const failures = new WeakMap<WebSocket, GatewayHandshakeError>()
+const MAX_ERROR_BYTES = 64 * 1024
+
+/** Selected handshake failures keep provider retry/auth metadata at the logical origin. */
+export class GatewayHandshakeError extends Error {
+  constructor(
+    readonly url: string,
+    readonly status: number,
+    readonly headers: Record<string, string>,
+    readonly body: string,
+    readonly truncated = false,
+  ) {
+    super(`WebSocket handshake refused (${status})`)
+    this.name = "GatewayHandshakeError"
+  }
+}
+
+export const logicalWebSocketURL = (socket: WebSocket) => logicalURLs.get(socket) ?? socket.url
+export const gatewayHandshakeError = (socket: WebSocket) => failures.get(socket)
+
+/** No global constructor/dispatcher mutation. The optional lookup is for isolated loopback controls. */
+export function createGatewayWebSocket(dependencies: { lookup?: LookupFunction } = {}) {
+  return (url: string, headers: Record<string, string>, timeout = 15_000): WebSocket | undefined => {
+    const selected = gatewayWebSocket(url, headers)
+    if (!selected) return undefined
+    if (!Number.isFinite(timeout) || timeout <= 0 || timeout > 60_000)
+      throw new TypeError("Invalid selected WebSocket timeout")
+    const dispatcher = new Agent({
+      connections: 1, pipelining: 0, allowH2: false, maxHeaderSize: 65536,
+      connect: { timeout, ...(dependencies.lookup && { lookup: dependencies.lookup }) },
+    })
+    const socket = new WebSocket(selected.url, {
+      headers: selected.headers,
+      followRedirects: false,
+      handshakeTimeout: timeout,
+      // ws retains its complete handshake validation and RFC6455 frame engine.
+      // Its public finishRequest hook bypasses Bun's fetch-backed node:http
+      // upgrade facade, without replacing any global constructor or dispatcher.
+      createConnection: () => new PassThrough(),
+      finishRequest: (request: ClientRequest, framed: WebSocket) => {
+        const target = new URL(selected.url)
+        let abort: ((error?: Error) => void) | undefined
+        let response: PassThrough | undefined
+        let resume: (() => void) | undefined
+        const originalDestroy = request.destroy.bind(request)
+        const originalAbort = request.abort.bind(request)
+        framed.once("close", () => originalDestroy())
+        request.setTimeout(0)
+        const wireHeaders = Object.entries(request.getHeaders()).flatMap(([name, value]) => {
+          // Undici supplies the connection/upgrade pair; retain all other ws
+          // handshake/auth header values in its documented flat wire format.
+          if (name === "connection" || name === "upgrade" || value === undefined) return []
+          return (Array.isArray(value) ? value : [value]).flatMap((entry) => [name, String(entry)])
+        })
+        request.destroy = (error?: Error) => {
+          abort?.(error ?? new Error("Selected WebSocket handshake cancelled"))
+          return originalDestroy(error)
+        }
+        request.abort = () => {
+          abort?.(new Error("Selected WebSocket handshake cancelled"))
+          originalAbort()
+        }
+        const deadline = setTimeout(() => request.destroy(new Error("Opening handshake has timed out")), timeout)
+        deadline.unref()
+        framed.once("close", () => clearTimeout(deadline))
+        const parseHeaders = (values: Buffer[] | string[] | null) => {
+          const result: Record<string, string> = {}
+          for (let index = 0; values && index < values.length; index += 2) {
+            const name = values[index].toString().toLowerCase()
+            const value = values[index + 1].toString()
+            result[name] = result[name] === undefined ? value : `${result[name]}, ${value}`
+          }
+          return result
+        }
+        dispatcher.dispatch({
+          origin: `http://${target.host}`, path: target.pathname + target.search,
+          method: "GET", upgrade: "websocket", headers: wireHeaders,
+          headersTimeout: timeout, bodyTimeout: Math.min(timeout, 10_000),
+        }, {
+          onConnect(value) { abort = value },
+          onHeaders(statusCode, headers, continueReading) {
+            clearTimeout(deadline)
+            resume = continueReading
+            response = Object.assign(new PassThrough({ highWaterMark: 16384 }), {
+              statusCode, headers: parseHeaders(headers),
+            })
+            response.on("drain", () => resume?.())
+            request.emit("response", response as unknown as IncomingMessage)
+            return true
+          },
+          onData(chunk) { return response?.write(chunk) ?? false },
+          onComplete() { response?.end() },
+          onUpgrade(statusCode, headers, stream) {
+            clearTimeout(deadline)
+            request.emit("upgrade", { statusCode, headers: parseHeaders(headers) }, stream, Buffer.alloc(0))
+            stream.resume()
+          },
+          onError(error) {
+            clearTimeout(deadline)
+            if (response) response.destroy(error)
+            else { originalDestroy(); request.emit("error", error) }
+          },
+        })
+      },
+    })
+    socket.once("close", () => { void dispatcher.destroy() })
+    logicalURLs.set(socket, url)
+    // A rejected upgrade never becomes a tunnel or a second origin. Read at most
+    // the bounded provider error body; redirects/refusal receipts expose no entity.
+    socket.on("unexpected-response", (_request, response) => {
+      const status = response.statusCode ?? 502
+      const refused = (status >= 300 && status <= 399) || response.headers["x-egress-refusal"] !== undefined
+      const headers: Record<string, string> = {}
+      if (!refused) {
+        for (const [key, value] of Object.entries(response.headers)) {
+          if (value !== undefined && !/^(?:x-egress-|x-butlers-|location$)/i.test(key))
+            headers[key] = Array.isArray(value) ? value.join(", ") : value
+        }
+      }
+      const chunks: Buffer[] = []
+      let size = 0
+      let done = false
+      const finish = (truncated = false) => {
+        if (done) return
+        done = true
+        clearTimeout(timer)
+        response.removeAllListeners("data")
+        response.removeAllListeners("end")
+        response.removeAllListeners("error")
+        response.on("error", () => {})
+        response.destroy()
+        const error = new GatewayHandshakeError(url, refused ? 403 : status, headers,
+          refused ? "Selected egress request refused" : Buffer.concat(chunks).toString("utf8"), truncated)
+        failures.set(socket, error)
+        // Consumers install their usual error/close handlers synchronously after construction.
+        socket.emit("error", error)
+        socket.terminate()
+      }
+      const timer = setTimeout(() => finish(true), Math.min(timeout, 10_000))
+      timer.unref()
+      socket.once("close", () => { clearTimeout(timer); response.destroy() })
+      socket.once("error", () => { clearTimeout(timer); response.destroy() })
+      if (refused) return finish()
+      response.on("data", (chunk: Buffer) => {
+        const remaining = MAX_ERROR_BYTES - size
+        chunks.push(chunk.subarray(0, remaining))
+        size += Math.min(chunk.length, remaining)
+        if (chunk.length > remaining) finish(true)
+      })
+      response.once("end", () => finish())
+      response.once("error", () => finish(true))
+      response.once("aborted", () => finish(true))
+    })
+    // Termination after a response refusal may produce a secondary implementation error.
+    socket.on("error", () => {})
+    return socket
+  }
+}
+
+export const gatewaySocket = createGatewayWebSocket()
