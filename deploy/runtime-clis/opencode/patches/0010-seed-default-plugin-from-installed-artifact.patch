+      exports[key] = { types: "./dist/" + stem + ".d.ts", import: "./dist/" + stem + ".js" }
+      await write(base + "/dist/" + stem + ".d.ts", "export declare const fixture: string\n")
+      await write(base + "/dist/" + stem + ".js", 'export const fixture = "owned-' + name + '"\n')
+    }
