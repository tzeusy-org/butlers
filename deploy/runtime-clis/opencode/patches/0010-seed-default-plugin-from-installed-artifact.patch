+  await fs.mkdir(path.join(seed, "node_modules/.bin"), { mode: 0o755 })
+  await fs.symlink("../cross-spawn/bin.js", path.join(seed, "node_modules/.bin/owned"))
+  await write("package-lock.json", JSON.stringify({ lockfileVersion: 3, packages }))
