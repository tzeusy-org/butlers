+    if (rel === "") continue
+    if (
+      !safe(rel) ||
+      !rel.startsWith("node_modules/") ||
+      !object(value) ||
+      value.link ||
+      typeof value.version !== "string"
+    )
+      fail()
+    const data = bytes.get(rel + "/package.json")
+    if (!data || JSON.parse(data.toString()).version !== value.version) fail()
+  }
+  for (const [name, version] of Object.entries(roots))
+    if (lock.packages["node_modules/" + name]?.version !== version) fail()
+  if (lock.packages["node_modules/@opencode-ai/sdk"]?.version !== "1.17.7") fail()
+  // Every installed package root must be represented by the real lock, including transitives.
+  for (const rel of bytes.keys()) {
+    if (!rel.endsWith("/package.json")) continue
+    const parent = rel.slice(0, -"/package.json".length)
+    if (/(?:^|\/)node_modules\/(?:@[^/]+\/)?[^/]+$/.test(parent) && !object(lock.packages[parent])) fail()
+  }
+  for (const [name, version, exports] of [
+    ["@opencode-ai/plugin", "1.17.7", [".", "./tool", "./tui"]],
+    [
+      "@opencode-ai/sdk",
+      "1.17.7",
+      [".", "./v2", "./client", "./server", "./v2/client", "./v2/server", "./v2/gen/client"],
+    ],
+  ] as const) {
+    const base = "node_modules/" + name
+    const data = bytes.get(base + "/package.json")
+    if (!data) fail()
+    const installed = JSON.parse(data.toString())
+    if (installed.name !== name || installed.version !== version || !exact(installed.exports, [...exports])) fail()
+    for (const conditions of Object.values(installed.exports) as unknown[]) {
+      if (!exact(conditions, ["types", "import"])) fail()
+      for (const target of Object.values(conditions as Record<string, unknown>)) {
+        if (
+          typeof target !== "string" ||
+          !target.startsWith("./") ||
+          !safe(target.slice(2)) ||
+          !bytes.has(base + "/" + target.slice(2))
+        )
+          fail()
+      }
+    }
+  }
+  // Follow every required package dependency using Node's nearest-node_modules layout.
+  // Optional/peer edges retain normal npm handling; no additional package is fetched here.
+  for (const rel of Object.keys(lock.packages).filter(Boolean)) {
+    const installed = JSON.parse(bytes.get(rel + "/package.json")!.toString())
+    if (!object(installed.dependencies ?? {})) fail()
+    for (const name of Object.keys(installed.dependencies ?? {})) {
+      if (!/^(?:@[^/]+\/)?[^/]+$/.test(name) || /[\\\x00-\x1f]/.test(name) || name === "." || name === "..") fail()
+      let parent = rel
+      let found = false
+      while (true) {
+        if (bytes.has(parent + "/node_modules/" + name + "/package.json")) {
+          found = true
+          break
+        }
