+async function install(request: any = add, executable = exe) {
+  // The fallback deliberately lets the same semantic regression execute on the old Npm implementation.
+  const factory = (Npm as { layerWith?: typeof Npm.layerWith }).layerWith
+  const implementation = factory?.(executable) ?? Npm.layer
+  const layer = implementation.pipe(
+    Layer.provide(EffectFlock.layer),
+    Layer.provide(FSUtil.layer),
+    Layer.provide(Global.layerWith({ cache: path.join(root, "cache"), state: path.join(root, "state") })),
+    Layer.provide(NodeFileSystem.layer),
+  )
+  return Effect.gen(function* () {
+    const npm = yield* Npm.Service
+    yield* npm.install(dest, request)
+  }).pipe(Effect.provide(layer), Effect.runPromise)
+}
