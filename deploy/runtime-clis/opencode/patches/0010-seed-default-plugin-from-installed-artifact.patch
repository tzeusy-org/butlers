+import { afterEach, beforeEach, describe, expect, spyOn, test } from "bun:test"
+import fs from "node:fs/promises"
+import path from "node:path"
+import { createHash } from "node:crypto"
+import { Effect, Layer } from "effect"
+import { NodeFileSystem } from "@effect/platform-node"
+import { Npm } from "../src/npm"
+import { FSUtil } from "../src/fs-util"
+import { Global } from "../src/global"
+import { EffectFlock } from "../src/util/effect-flock"
+
+const add = { add: [{ name: "@opencode-ai/plugin", version: "1.17.7" }] }
+const roots = {
+  "@opencode-ai/plugin": "1.17.7",
+  "@opentui/core": "0.3.4",
+  "@opentui/keymap": "0.3.4",
+  "@opentui/solid": "0.3.4",
+}
+const hash = (data: Uint8Array) => createHash("sha256").update(data).digest("hex")
+let root: string, seed: string, dest: string, exe: string, calls: number, trap: ReturnType<typeof spyOn>
+const saved = { mode: process.env.BUTLERS_EGRESS_MODE, address: process.env.BUTLERS_EGRESS_GATEWAY }
+async function write(relative: string, data: string, mode = 0o644) {
+  const file = path.join(seed, relative)
+  await fs.mkdir(path.dirname(file), { recursive: true, mode: 0o755 })
+  await fs.writeFile(file, data, { mode })
+  await fs.chmod(file, mode)
+}
+async function inventory() {
+  const entries: any[] = []
+  async function walk(dir = "") {
+    for (const name of (await fs.readdir(path.join(seed, dir))).sort()) {
+      const rel = dir ? dir + "/" + name : name
+      if (rel === "seed.json") continue
+      const file = path.join(seed, rel),
+        stat = await fs.lstat(file)
+      if (stat.isSymbolicLink()) entries.push({ path: rel, type: "link", target: await fs.readlink(file) })
+      else if (stat.isDirectory()) {
+        entries.push({ path: rel, type: "directory", mode: stat.mode & 0o7777 })
+        await walk(rel)
+      } else entries.push({ path: rel, type: "file", mode: stat.mode & 0o7777, sha256: hash(await fs.readFile(file)) })
+    }
+  }
+  await walk()
+  return entries.sort((a, b) => (a.path < b.path ? -1 : 1))
+}
+async function seal(mutate?: (value: any) => void) {
+  const value = {
+    schema: "butlers.opencode-default-plugin/v1",
+    package: "@opencode-ai/plugin",
+    version: "1.17.7",
+    node: "v22.23.4",
+    npm: "10.9.9",
+    package_lock_sha256: hash(await fs.readFile(path.join(seed, "package-lock.json"))),
+    entries: await inventory(),
+    provenance: { fixture: "synthetic-complete-shaped graph; not public package certification" },
+  }
+  mutate?.(value)
+  await write("seed.json", JSON.stringify(value))
+}
+async function fixture() {
+  await write("package.json", JSON.stringify({ private: true, dependencies: roots }))
+  const packages: any = { "": { dependencies: roots } }
+  for (const [name, version, keys, dependencies] of [
+    [
+      "@opencode-ai/plugin",
+      "1.17.7",
+      [".", "./tool", "./tui"],
+      { "@opencode-ai/sdk": "1.17.7", effect: "4.0.0-beta.74", zod: "4.1.8" },
