+  "missing-package",
+  "missing-export",
+  "missing-transitive",
+  "dangling",
+  "escape",
+  "cycle",
+  "absolute-link",
+  "metadata-link",
+  "destination-symlink",
+] as const) {
+  test("refuses " + mutation + " before writes or reify", async () => {
+    const bin = path.join(seed, "node_modules/cross-spawn/bin.js")
+    if (mutation === "missing") await fs.rm(seed, { recursive: true })
+    else if (mutation === "bad-json") await write("seed.json", "{")
+    else if (mutation === "wrong-file-mode") {
+      await fs.chmod(bin, 0o600)
+      await seal()
+    } else if (mutation === "wrong-root-mode") await fs.chmod(seed, 0o775)
+    else if (mutation === "changed-byte") await fs.writeFile(bin, "drift")
+    else if (mutation === "extra-file") await write("node_modules/undeclared", "drift")
+    else if (mutation === "missing-package") {
+      await fs.rm(path.join(seed, "node_modules/@opencode-ai/sdk"), { recursive: true })
+      await seal()
+    } else if (mutation === "missing-export") {
+      await fs.rm(path.join(seed, "node_modules/@opencode-ai/plugin/dist/tool/index.js"))
+      await seal()
+    } else if (mutation === "missing-transitive") {
+      await fs.rm(path.join(seed, "node_modules/cross-spawn"), { recursive: true })
+      await seal()
+    } else if (["dangling", "escape", "cycle", "absolute-link"].includes(mutation)) {
+      const link = path.join(seed, "node_modules/.bin/owned")
+      await fs.unlink(link)
+      await fs.symlink(
+        mutation === "dangling"
+          ? "../absent"
+          : mutation === "escape"
+            ? "../../../outside"
+            : mutation === "cycle"
+              ? "owned"
+              : "/tmp",
+        link,
+      )
+      await seal()
+    } else if (mutation === "metadata-link") {
+      await fs.rename(path.join(seed, "seed.json"), path.join(root, "metadata"))
+      await fs.symlink(path.join(root, "metadata"), path.join(seed, "seed.json"))
+    } else if (mutation === "destination-symlink") {
+      await fs.rename(dest, dest + "-real")
+      await fs.symlink(dest + "-real", dest)
+    } else
+      await seal((value) => {
+        if (mutation === "unknown-field") value.extra = true
+        else if (mutation === "wrong-version") value.version = "1.17.8"
+        else if (mutation === "wrong-node") value.node = "v22.0.0"
+        else if (mutation === "wrong-npm") value.npm = "10.0.0"
+        else if (mutation === "no-provenance") value.provenance = {}
+        else if (mutation === "lock-hash") value.package_lock_sha256 = "0".repeat(64)
+        else if (mutation === "omitted") value.entries.pop()
+        else if (mutation === "duplicate") value.entries.push(value.entries.at(-1))
+        else if (mutation === "unsorted") value.entries.reverse()
+        else if (mutation === "unsafe-path") value.entries[0].path = "../escape"
+      })
+    await unchangedFailure()
+  })
+}
+for (const mode of [
