+/** Offline default dependency for the fixed installed request-v1 layout only. */
+import fs from "node:fs/promises"
+import { constants } from "node:fs"
+import path from "node:path"
+import { createHash } from "node:crypto"
+import { ButlersEgress } from "@opencode-ai/llm/route"
+
+type Request = { add: { name: string; version?: string }[] } | undefined
+type Entry =
+  | { path: string; type: "directory"; mode: number }
+  | { path: string; type: "file"; mode: number; sha256: string }
+  | { path: string; type: "link"; target: string }
+const hash = (data: Uint8Array) => createHash("sha256").update(data).digest("hex")
+function fail(): never {
+  throw new Error("Invalid installed default-plugin seed or destination")
+}
+const object = (value: unknown): value is Record<string, any> =>
+  !!value && typeof value === "object" && !Array.isArray(value)
+const exact = (value: unknown, keys: string[]) =>
+  object(value) && Object.keys(value).sort().join("\0") === keys.sort().join("\0")
+const safe = (name: string) =>
+  name.length > 0 &&
+  !name.includes("\\") &&
+  !/[\x00-\x1f\x7f]/.test(name) &&
+  name.split("/").every((part) => part !== "" && part !== "." && part !== "..")
+const exists = async (file: string) => {
+  try {
+    await fs.lstat(file)
+    return true
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return false
+    throw error
+  }
+}
+async function regular(file: string, mode?: number) {
+  const stream = await fs.open(file, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK)
+  try {
+    const stat = await stream.stat()
+    if (!stat.isFile() || (mode !== undefined && (stat.mode & 0o7777) !== mode)) fail()
+    return await stream.readFile()
+  } finally {
+    await stream.close()
+  }
+}
+async function directory(file: string) {
+  const stat = await fs.lstat(file)
+  if (!stat.isDirectory() || stat.isSymbolicLink() || (stat.mode & 0o7777) !== 0o755) fail()
+}
+async function realParents(file: string) {
+  for (let item = path.resolve(file); ; item = path.dirname(item)) {
+    const stat = await fs.lstat(item)
+    if (!stat.isDirectory() || stat.isSymbolicLink()) fail()
+    if (item === path.dirname(item)) break
+  }
+}
+const roots = {
+  "@opencode-ai/plugin": "1.17.7",
+  "@opentui/core": "0.3.4",
+  "@opentui/keymap": "0.3.4",
+  "@opentui/solid": "0.3.4",
+}
+function dependencies(pkg: Record<string, any>) {
+  if (!exact(pkg.dependencies, Object.keys(roots))) fail()
+  for (const [name, version] of Object.entries(roots)) if (pkg.dependencies[name] !== version) fail()
+  for (const key of ["devDependencies", "peerDependencies", "optionalDependencies"])
+    if (pkg[key] !== undefined && (!object(pkg[key]) || Object.keys(pkg[key]).length)) fail()
+  if (pkg.workspaces !== undefined) fail()
+}
+
+/** The optional executable is an explicit source-fixture seam, never an environment override. */
+export async function seedDefaultPlugin(dir: string, input: Request, executable = process.execPath) {
+  if (path.basename(executable) !== "opencode.exe" || path.basename(path.dirname(executable)) !== "bin") return false
+  if (input?.add.length !== 1 || input.add[0]?.name !== "@opencode-ai/plugin" || input.add[0]?.version !== "1.17.7")
+    return false
+  const destination = path.resolve(dir)
+  for (const name of ["package.json", "package-lock.json", "node_modules"])
+    if (await exists(path.join(destination, name))) return false
+  if (!ButlersEgress.gatewayConfig()) return false
+  await realParents(destination)
+  const root = path.resolve(path.dirname(executable), "..", "default-plugin")
+  await directory(root)
+  const metadata = await regular(path.join(root, "seed.json"), 0o644)
+  const seed = JSON.parse(metadata.toString())
+  if (
+    !exact(seed, ["schema", "package", "version", "node", "npm", "package_lock_sha256", "entries", "provenance"]) ||
+    seed.schema !== "butlers.opencode-default-plugin/v1" ||
+    seed.package !== "@opencode-ai/plugin" ||
+    seed.version !== "1.17.7" ||
+    seed.node !== "v22.23.4" ||
+    seed.npm !== "10.9.9" ||
+    !/^[0-9a-f]{64}$/.test(seed.package_lock_sha256) ||
+    !Array.isArray(seed.entries) ||
+    !object(seed.provenance) ||
+    Object.keys(seed.provenance).length === 0
+  )
+    fail()
+  const expected = new Map<string, Entry>()
+  let previous = ""
+  for (const entry of seed.entries) {
+    if (
+      !object(entry) ||
+      typeof entry.path !== "string" ||
+      !safe(entry.path) ||
+      entry.path <= previous ||
+      entry.path === "seed.json"
+    )
+      fail()
+    previous = entry.path
+    if (entry.type === "directory") {
+      if (!exact(entry, ["path", "type", "mode"]) || entry.mode !== 0o755) fail()
+    } else if (entry.type === "file") {
+      if (
+        !exact(entry, ["path", "type", "mode", "sha256"]) ||
+        ![0o644, 0o755].includes(entry.mode) ||
+        !/^[0-9a-f]{64}$/.test(entry.sha256)
+      )
+        fail()
+    } else if (entry.type === "link") {
+      if (
+        !exact(entry, ["path", "type", "target"]) ||
+        typeof entry.target !== "string" ||
+        !entry.target ||
+        path.isAbsolute(entry.target) ||
+        /[\\\x00-\x1f\x7f]/.test(entry.target)
+      )
+        fail()
+    } else fail()
+    // This is a fixed npm seed, not a general-purpose file overlay.
+    if (!["package.json", "package-lock.json", "node_modules"].includes(entry.path.split("/")[0])) fail()
+    expected.set(entry.path, entry as Entry)
+  }
+  const bytes = new Map<string, Buffer>()
+  const observed = new Set<string>()
+  async function walk(relative = "") {
+    for (const name of (await fs.readdir(path.join(root, relative))).sort()) {
+      const rel = relative ? relative + "/" + name : name
+      if (rel === "seed.json") continue
+      const entry = expected.get(rel)
+      if (!safe(rel) || !entry) fail()
+      const file = path.join(root, rel)
+      const stat = await fs.lstat(file)
+      if (entry.type === "directory") {
+        await directory(file)
+        await walk(rel)
+      } else if (entry.type === "file") {
+        if (!stat.isFile() || stat.isSymbolicLink()) fail()
+        const data = await regular(file, entry.mode)
+        if (hash(data) !== entry.sha256) fail()
+        bytes.set(rel, data)
+      } else {
+        if (!stat.isSymbolicLink() || (await fs.readlink(file)) !== entry.target) fail()
+        const target = await fs.realpath(file) // dangling/cyclic links refuse here
+        if (target !== root && !target.startsWith(root + path.sep)) fail()
+      }
+      observed.add(rel)
+    }
+  }
+  await walk()
+  if (observed.size !== expected.size) fail()
+  const pkgBytes = bytes.get("package.json"),
+    lockBytes = bytes.get("package-lock.json")
+  if (
+    !pkgBytes ||
+    !lockBytes ||
+    hash(lockBytes) !== seed.package_lock_sha256 ||
+    expected.get("node_modules")?.type !== "directory"
+  )
+    fail()
+  const pkg = JSON.parse(pkgBytes.toString()),
+    lock = JSON.parse(lockBytes.toString())
+  if (
+    !object(pkg) ||
+    !object(lock) ||
+    ![2, 3].includes(lock.lockfileVersion) ||
+    !object(lock.packages) ||
+    !object(lock.packages[""])
+  )
+    fail()
+  dependencies(pkg)
+  dependencies(lock.packages[""])
