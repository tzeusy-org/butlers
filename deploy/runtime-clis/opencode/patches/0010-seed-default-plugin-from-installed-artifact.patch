+      delete process.env.BUTLERS_EGRESS_GATEWAY
+    }
+    if (mode === "platform-binary") executable = path.join(root, "opencode")
+    if (mode === "arbitrary") request = { add: [{ name: "other-plugin", version: "1.17.7" }] }
+    if (mode === "wrong-default-version") request = { add: [{ name: "@opencode-ai/plugin", version: "1.17.8" }] }
+    if (mode === "multiple-request") request = { add: [...add.add, { name: "other", version: "1" }] }
+    if (mode === "existing-package")
+      await fs.writeFile(path.join(dest, "package.json"), JSON.stringify({ dependencies: { custom: "1" } }))
+    if (mode === "existing-lock") await fs.writeFile(path.join(dest, "package-lock.json"), "{}")
+    await expect(install(request, executable)).rejects.toThrow()
+    expect(calls).toBe(1)
+  })
+}
