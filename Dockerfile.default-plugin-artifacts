# syntax=docker/dockerfile:1.7
FROM python:3.12.13-slim-trixie@sha256:c2d8472b831337ab296a8ce652e1ba786e9e3034fc445dc58b50a7f5251f0003 AS producer

COPY scripts/runtime_clis/install_system_artifacts.py /recipe/scripts/runtime_clis/install_system_artifacts.py
COPY deploy/runtime-clis/debian-system-inputs.json /recipe/deploy/runtime-clis/debian-system-inputs.json
RUN --network=none --mount=from=system-artifacts,source=debs,target=/inputs/system,readonly \
    python3 -I -B /recipe/scripts/runtime_clis/install_system_artifacts.py \
      --manifest /recipe/deploy/runtime-clis/debian-system-inputs.json \
      --artifacts /inputs/system --profile compiler

# Complete official Node/npm, including every original toolchain file.
COPY --from=toolchain-artifacts /components/node/ /opt/node/
COPY scripts/runtime_clis/produce_default_plugin_artifact.py scripts/runtime_clis/runtime_artifacts.py scripts/runtime_clis/produce_codex_artifacts.py scripts/runtime_clis/produce_native_packages.py /recipe/scripts/runtime_clis/
COPY deploy/runtime-clis/toolchains.json deploy/runtime-clis/runtime-inputs.json /recipe/deploy/runtime-clis/
COPY deploy/runtime-clis/default-plugin-artifacts/ /recipe/deploy/runtime-clis/default-plugin-artifacts/
COPY Dockerfile.default-plugin-artifacts /recipe/Dockerfile.default-plugin-artifacts
WORKDIR /opt/plugin-build

# Public preparation runs ordinary npm ci with all original lifecycle hooks.
# It retains a NONFINAL complete cache, lock, metadata and exact public archives.
RUN --network=default --mount=type=tmpfs,target=/root \
    python3 -I -B /recipe/scripts/runtime_clis/produce_default_plugin_artifact.py --phase public-seed

# Fresh offline ci and all nineteen imports run with no external route.
# The twelve complete non-target archives are data, never executed here.
RUN --network=none --mount=type=tmpfs,target=/root \
    python3 -I -B /recipe/scripts/runtime_clis/produce_default_plugin_artifact.py --phase build

FROM scratch AS artifacts
COPY --from=producer /artifacts/default-plugin/ /
